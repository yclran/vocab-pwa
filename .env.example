# ============================================================
# 复制此文件为 .env.local 后填写。.env.local 已被 .gitignore 忽略，
# 且这些变量只在 Node 侧读取，不会打包进前端代码。
# ============================================================

# 中文释义补全服务商：youdao | baidu
# 不填 = 不启用，应用照常可用（音标/发音/词性/英文释义由 Free Dictionary 提供，免费无需 key）
TRANSLATE_PROVIDER=youdao

# --- 有道智云 ---------------------------------------------------
# 注册：https://ai.youdao.com/  控制台创建「文本翻译」应用后获取
# 注意：付费服务，官方仅赠送 50 元体验金，用完需充值
# 注意：该接口自 2024.04.22 v3.0.0 起已下线词典数据，只返回机翻结果
YOUDAO_APP_KEY=
YOUDAO_APP_SECRET=

# --- 百度翻译 ---------------------------------------------------
# 注册：https://api.fanyi.baidu.com/
# 同样只返回机翻结果，无音标无词性
BAIDU_TRANSLATE_APPID=
BAIDU_TRANSLATE_SECRET=
